POST {{host}}/api/XFUELS/PurchaseOrder
Content-Type: application/json

{
  "supplierCode": "VENC001",
  "purchaseRequisitionNumber": "PR-XF-001",
  "lines": [
    {
      "inventoryItemCode": "TESTING",
      "quantity": 1,
      "unitPrice": 1000.00,
      "taxCode": "15"
    }
  ]
}

