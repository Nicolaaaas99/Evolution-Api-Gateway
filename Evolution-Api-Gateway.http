@host = http://localhost:5245

#####################################################################
# VIEW DATA ENDPOINTS - GET requests (read-only, no SDK needed)
#####################################################################

### ==================== XFUELS ====================

### Get Expense Stock Items - XFUELS
GET {{host}}/api/XFUELS/ViewData/ExpenseStockItems
Accept: application/json

###

### Get Trade Suppliers - XFUELS (expects: VENC001 - Vencor Holdings)
GET {{host}}/api/XFUELS/ViewData/TradeSuppliers
Accept: application/json

###

### Get Projects - XFUELS (expects: S-BAUMANS, S-BND_RENOVATORS, etc.)
GET {{host}}/api/XFUELS/ViewData/Projects
Accept: application/json

###

### Get Created Purchase Orders - XFUELS
GET {{host}}/api/XFUELS/ViewData/CreatedPurchaseOrders
Accept: application/json

###

### ==================== TENELLA ====================

### Get Expense Stock Items - TENELLA (expects: INSURANCE, ELECTRICITY, RENT PAID)
GET {{host}}/api/TENELLA/ViewData/ExpenseStockItems
Accept: application/json

###

### Get Trade Suppliers - TENELLA (expects: BII001, BLI001, BLU001, BUC001, BUI001)
GET {{host}}/api/TENELLA/ViewData/TradeSuppliers
Accept: application/json

###

### Get Projects - TENELLA
GET {{host}}/api/TENELLA/ViewData/Projects
Accept: application/json

###

### ==================== LITTLE ====================

### Get Expense Stock Items - LITTLE (expects: TYR-385/65R22.5 LANV, FUEL, PARKING)
GET {{host}}/api/LITTLE/ViewData/ExpenseStockItems
Accept: application/json

###

### Get Trade Suppliers - LITTLE (expects: empty - no suppliers)
GET {{host}}/api/LITTLE/ViewData/TradeSuppliers
Accept: application/json

###

### Get Projects - LITTLE
GET {{host}}/api/LITTLE/ViewData/Projects
Accept: application/json

###

### ==================== JOUXE ====================

### Get Expense Stock Items - JOUXE (expects: SALPAYE, SALCTC)
GET {{host}}/api/JOUXE/ViewData/ExpenseStockItems
Accept: application/json

###

### Get Trade Suppliers - JOUXE (expects: GRW001, GSE001, H2O001, HAR001)
GET {{host}}/api/JOUXE/ViewData/TradeSuppliers
Accept: application/json

###

### Get Projects - JOUXE
GET {{host}}/api/JOUXE/ViewData/Projects
Accept: application/json

###

### ==================== TOBORA ====================

### Get Expense Stock Items - TOBORA (expects: SALCTC, ZZ-ENTERTAINMENT, ZZ-ACCOUNTING FEE, ZZ-ADVERTISING, ZZ-BAD DEBTS)
GET {{host}}/api/TOBORA/ViewData/ExpenseStockItems
Accept: application/json

###

### Get Trade Suppliers - TOBORA (expects: ALP001, CASH, CRD001, JAN001, NAG001)
GET {{host}}/api/TOBORA/ViewData/TradeSuppliers
Accept: application/json

###

### Get Projects - TOBORA (expects: none)
GET {{host}}/api/TOBORA/ViewData/Projects
Accept: application/json

###

### Get Created Purchase Orders - TOBORA
GET {{host}}/api/TOBORA/ViewData/CreatedPurchaseOrders
Accept: application/json

###

### ==================== INVALID COMPANY (should return error) ====================

### Invalid company - should list available companies
GET {{host}}/api/INVALID/ViewData/ExpenseStockItems
Accept: application/json

###

#####################################################################
# PURCHASE ORDER ENDPOINTS - Create, Get Detail, Process
#####################################################################

### ==================== CREATE PO - XFUELS ====================
### Creates a PO for Vencor Holdings with Advertising & Consulting lines
### Assigned to different XFUELS projects
POST {{host}}/api/XFUELS/PurchaseOrder
Content-Type: application/json

{
  "supplierCode": "VENC001",
  "externalOrderNumber": "EXT-XF-001",
  "purchaseRequisitionNumber": "PR-XF-001",
  "invoiceDate": "2026-04-16",
  "deliverToAddress": "123 Main Street, Johannesburg",
  "invoiceToAddress": "456 Office Park, Sandton",
  "lines": [
    {
      "inventoryItemCode": "ADVERT",
      "quantity": 1,
      "unitPrice": 5000.00,
      "taxCode": "15",
      "warehouseCode": "Expenses",
      "projectCode": "S-BAUMANS",
      "description": "April 2026 Advertising Campaign"
    },
    {
      "inventoryItemCode": "CONSULT",
      "quantity": 2,
      "unitPrice": 7500.00,
      "taxCode": "15",
      "warehouseCode": "Expenses",
      "projectCode": "S-DINFUEL",
      "description": "Consulting - Site Assessment"
    }
  ]
}

###

### ==================== CREATE PO - TENELLA ====================
