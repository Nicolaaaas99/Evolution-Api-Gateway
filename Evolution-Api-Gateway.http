      "description": "Electricity April 2026"
    },
    {
      "inventoryItemCode": "RENT PAID",
      "quantity": 1,
      "unitPrice": 12000.00,
      "taxCode": "15",
      "warehouseCode": "Expenses",
      "projectCode": "O-OTHER",
      "description": "Office Rent April 2026"
    }
  ]
}

