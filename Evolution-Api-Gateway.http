### ==================== CREATE PO - XFUELS (negative quantity rounding adjustment) ====================
### Creates a PO for Vencor Holdings with a normal line and a negative quantity rounding adjustment
POST {{host}}/api/XFUELS/PurchaseOrder
Content-Type: application/json

{
  "supplierCode": "VENC001",
  "externalOrderNumber": "EXT-XF-002",
  "purchaseRequisitionNumber": "PR-XF-002",
  "invoiceDate": "2026-04-17",
  "lines": [
    {
      "inventoryItemCode": "ADVERT",
      "quantity": 10,
      "unitPrice": 1500.00,
      "taxCode": "15",
      "warehouseCode": "Expenses",
      "projectCode": "S-BAUMANS",
      "description": "Advertising - Monthly Batch"
    },
    {
      "inventoryItemCode": "ADVERT",
      "quantity": -1,
      "unitPrice": 350.00,
      "taxCode": "15",
      "warehouseCode": "Expenses",
      "projectCode": "S-BAUMANS",
      "description": "Advertising - Rounding Adjustment"
    }
  ]
}

###

