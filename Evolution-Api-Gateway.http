###

### ==================== GET PO DETAIL ====================
### Replace PO_NUMBER_HERE with the actual PO number returned from Create

### Get PO Detail - XFUELS
GET {{host}}/api/XFUELS/PurchaseOrder/Detail/PO_NUMBER_HERE
Accept: application/json

###

### Get PO Detail - TENELLA
GET {{host}}/api/TENELLA/PurchaseOrder/Detail/PO_NUMBER_HERE
Accept: application/json

###

### Get PO Detail - JOUXE
GET {{host}}/api/JOUXE/PurchaseOrder/Detail/PO_NUMBER_HERE
Accept: application/json

###

### Get PO Detail - TOBORA
GET {{host}}/api/TOBORA/PurchaseOrder/Detail/PO_NUMBER_HERE
Accept: application/json

###

### ==================== PROCESS PO (Full) - XFUELS ====================
### Replace PO_NUMBER_HERE with actual PO number
### Full processing - processes all remaining quantities
POST {{host}}/api/XFUELS/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-XF-001",
  "invoiceDate": "2026-04-16"
}

###

### ==================== PROCESS PO (Partial) - TENELLA ====================
### Replace PO_NUMBER_HERE with actual PO number
### Partial processing - only process the Electricity line
POST {{host}}/api/TENELLA/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-TN-001",
  "invoiceDate": "2026-04-16",
  "linesToProcess": [
    {
      "inventoryItemCode": "ELECTRICITY",
      "quantityToProcess": 1
    }
  ]
}

###

### ==================== PROCESS PO (Full) - JOUXE ====================
### Replace PO_NUMBER_HERE with actual PO number
POST {{host}}/api/JOUXE/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-JX-001",
  "invoiceDate": "2026-04-16"
}

###

### ==================== PROCESS PO (Full) - TOBORA ====================
### Replace PO_NUMBER_HERE with actual PO number
POST {{host}}/api/TOBORA/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-TB-001",
  "invoiceDate": "2026-04-17"
}

###

### ==================== PROCESS PO (Partial) - TOBORA ====================
### Replace PO_NUMBER_HERE with actual PO number
### Partial processing - only process the Salary CTC line
POST {{host}}/api/TOBORA/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-TB-002",
  "invoiceDate": "2026-04-17",
  "linesToProcess": [
    {
      "inventoryItemCode": "SALCTC",
      "quantityToProcess": 1
    }
  ]
}

###

### ==================== VIEW CREATED POs AFTER PROCESSING ====================

### Check POs - XFUELS (should show processed PO with invoice)
GET {{host}}/api/XFUELS/ViewData/CreatedPurchaseOrders
Accept: application/json

###

### Check POs - TENELLA (should show partially processed PO)
GET {{host}}/api/TENELLA/ViewData/CreatedPurchaseOrders
Accept: application/json

###

### Check specific PO invoices - replace PO_NUMBER_HERE
GET {{host}}/api/TENELLA/ViewData/CreatedPurchaseOrders/PO_NUMBER_HERE
Accept: application/json

###

### ==================== PROCESS REMAINING - TENELLA ====================
### After partial processing above, process the remaining Rent line
### Replace PO_NUMBER_HERE with actual PO number
POST {{host}}/api/TENELLA/PurchaseOrder/PO_NUMBER_HERE/process
Content-Type: application/json

{
  "supplierInvoiceNumber": "SINV-TN-002",
  "invoiceDate": "2026-04-16",
  "linesToProcess": [
    {
      "inventoryItemCode": "RENT PAID",
      "quantityToProcess": 1
    }
  ]
}

###

